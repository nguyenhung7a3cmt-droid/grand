# GrandStock Environment Variables Template
PORT=5173
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_INVITE_TOKEN=your_admin_invite_token_here
STAFF_KEY=your_staff_creation_key_here

# Discord Integration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_VOUCH_CHANNEL_ID=your_vouch_channel_id_here
DISCORD_ORDER_WEBHOOK=your_discord_order_webhook_url_here

# Gmail SMTP for OTP
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password_here

# Stripe Payment
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
